# ────────────────────────────────────────────────────────────────────────────
# LearnHub AI — Client Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase (client-side — uses anon key, NOT service role key) ───────────────
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# ── Backend API ────────────────────────────────────────────────────────────────
# The Vite dev proxy in vite.config.js routes /api → http://localhost:3001.
# For production builds (e.g. Vercel), set VITE_API_BASE_URL to your Render URL:
# VITE_API_BASE_URL=https://learnhub-ai-server.onrender.com
