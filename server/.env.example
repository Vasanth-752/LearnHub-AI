# ────────────────────────────────────────────────────────────────────────────
# LearnHub AI — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MODEL_FLASH=gemini-1.5-flash

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# Create a key at: https://console.cloud.google.com/ → APIs & Services → Credentials
YOUTUBE_API_KEY=your-youtube-data-api-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL of your frontend app (Vite dev server or Vercel URL in production)
FRONTEND_URL=http://localhost:5173
